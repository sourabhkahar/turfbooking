# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=turf_booking

# At least 32 random characters in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → secret you set there (required in production)
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX current account number used for owner payouts
RAZORPAY_ACCOUNT_NUMBER=
# route  = owner's share is split to their Razorpay linked account at payment time (default)
# payout = platform collects everything and pays owners later via RazorpayX
SETTLEMENT_MODE=route
# Fallback platform commission %, used only if app_settings.platform_fee_percent is missing
PLATFORM_FEE_PERCENT=2
# Dev only: mark payouts processed without calling RazorpayX. Ignored in production.
PAYOUT_SIMULATE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
